generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MenuItem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  price       Float
  category    String
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyMenu {
  id     String   @id @default(cuid())
  date   DateTime @unique
  active Boolean  @default(true)
  items  String
}

model Client {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  orders    Int      @default(0)
  lastOrder DateTime?
  createdAt DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  phone     String
  items     String
  type      String   @default("delivery")
  address   String?
  schedule  String?
  total     Float
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  phone     String   @unique
  step      String   @default("welcome")
  data      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
