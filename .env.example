# Base de datos (PostgreSQL)
# Local: usa Docker o PostgreSQL instalado
# Producción: Render PostgreSQL (se configura automáticamente)
DATABASE_URL="postgresql://user:password@localhost:5432/hectors_food"

# Panel Admin (usar solo UNA de las dos opciones)
# Opción 1: Contraseña en texto plano (solo desarrollo)
# ADMIN_PASSWORD="tu_contraseña_aqui"
# Opción 2: Hash bcrypt (recomendado para producción)
# Generar con: node -e "console.log(require('bcryptjs').hashSync('tu_contraseña', 12))"
# ADMIN_PASSWORD_HASH="$2b$12$..."

# Meta WhatsApp Cloud API (requiere cuenta Business)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_VERIFY_TOKEN="hectors_verify_2024"
# App Secret de Meta (para verificar firmas del webhook)
WHATSAPP_APP_SECRET=""

# Número público para botón WhatsApp (formato E.164 sin +)
NEXT_PUBLIC_WHATSAPP_NUMBER="521234567890"
